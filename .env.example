# --- Telegram (required) ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Chat/channel id where calls get posted (use @userinfobot to find your own id,
# or add the bot to a channel as admin and use the channel's numeric id, e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=
# Your personal Telegram user id. Only this user gets ANY interactive response,
# anywhere — leave it blank and the bot answers everyone, which is only sane
# for solo use on a private bot.
ADMIN_USER_ID=
# Optional extra broadcast destinations (comma separated), e.g. @yourchannel.
# Add the bot as a channel admin with "Post Messages" permission first —
# messages go to these plus TELEGRAM_CHAT_ID.
TELEGRAM_SIGNAL_CHANNELS=

# --- Which chains to watch ---
# Comma separated. Defaults to Base and Robinhood Chain. Ethereum is
# deliberately not a default: gas there makes a mint bot's economics
# nonsensical, and the bot infrastructure is already saturated.
NFT_CHAINS=base,robinhood

# --- RPC endpoints ---
# The per-chain defaults in src/chains.js already fail over across several
# free endpoints, so this is optional. Note that Robinhood Chain's WSS is a
# SEQUENCER FEED, not a JSON-RPC endpoint — it is not usable as an RPC and
# the bot knows not to derive one from it.
ROBINHOOD_WSS_RPC=wss://feed.mainnet.chain.robinhood.com
# Set one of these to put a private/paid endpoint at the FRONT of the failover
# list — it then builds nonces and broadcasts every transaction, with the
# defaults kept only as backups. Comma-separate for your own ordered list.
# Worth setting if you mint with real funds: free endpoints intermittently
# refuse requests, and while failover absorbs that, a dedicated endpoint
# avoids it entirely.
# BASE_HTTP_RPC=https://your-endpoint
# ROBINHOOD_HTTP_RPC=https://your-endpoint

# --- Wallet passcode lock (set this) ---
# Required before the Wallet menu opens at all. Behind that menu sit "reveal
# the private key" and "replace the key", so leaving this blank locks the
# menu out entirely — it fails closed, not open. The name is historical; it
# predates this being an NFT-only bot.
REAL_TRADING_PASSCODE=

# --- Wallet private key (optional) ---
# NEVER share this value. Paste it here yourself, directly in this file. Use a
# wallet dedicated to this bot, funded only with what you're fully prepared to
# lose. Mints spread across the separate burner wallets managed by
# /mintwallets (stored in data/mintWallets.json, which is gitignored) — this
# key is only used for buying and listing on the secondary market.
WALLET_PRIVATE_KEY=

# --- Optional: Etherscan API key (free tier) ---
# Deployer lookups via the multichain Etherscan V2 API. Leave blank and the
# bot falls back to Blockscout, which is unauthenticated but allows roughly
# 10 requests per 26-minute window per host.
ETHERSCAN_API_KEY=

# --- Optional: GoPlus Security API key ---
# Works unauthenticated at low volume; get an App Key + App Secret pair from
# https://console.gopluslabs.io if you get rate limited. Note that GoPlus does
# not cover Robinhood Chain at all, which is why the hard gate is self-hosted
# bytecode analysis rather than an aggregator lookup.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- Optional: OpenSea API key ---
# Powers collection discovery, wallet copy-trading, floor prices and listing.
# Get one at https://docs.opensea.io/reference/api-keys. Leave blank and those
# features stay off — reading a drop, scanning it, simulating the exit and
# minting it all work without OpenSea, which is the point.
OPENSEA_API_KEY=
